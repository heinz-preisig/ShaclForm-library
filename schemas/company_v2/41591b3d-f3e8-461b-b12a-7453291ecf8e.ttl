@prefix dash: <http://datashapes.org/dash#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://example.org/schema/41591b3d-f3e8-461b-b12a-7453291ecf8e/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Root Shape
schema:Company a sh:NodeShape ;
    sh:targetClass <https://example.org/company#Company> ;
    rdfs:label "Company" ;
    rdfs:comment "A registered company or organisation." ;
    dcterms:source <http://example.org/brick/5196dfff-abde-41d3-b7ce-a098d2994b1a/1.0.0/> ;
    sh:property [
        sh:path <https://example.org/company#companyName> ;
        sh:name "Company name"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 1 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/company#registrationNumber> ;
        sh:name "Registration number"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/company#contactEmail> ;
        sh:name "Contact email"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 3 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/company#foundedDate> ;
        sh:name "Founded date"@en ;
        sh:datatype xsd:date ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 4 ;
        dash:editor dash:DatePickerEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/company#registeredAddress> ;
        sh:node schema:RegisteredAddress ;
        sh:name "Registered address"@en ;
        sh:order 5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] .

# Component: 4a6e37fd-69eb-4de5-be12-80757d11e81d (depth 0)
schema:RegisteredAddress a sh:NodeShape ;
    sh:targetClass <https://example.org/address#Address> ;
    rdfs:label "RegisteredAddress" ;
    rdfs:comment "A postal or physical address." ;
    dcterms:source <http://example.org/brick/cb76e532-08ea-44db-b439-802ba99472d4/1.0.0/> ;
    sh:property [
        sh:path <https://example.org/address#street> ;
        sh:name "Street"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 1 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/address#city> ;
        sh:name "City"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/address#postalCode> ;
        sh:name "Postal code"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 3 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/address#region> ;
        sh:name "Region"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 4 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/address#country> ;
        sh:name "Country"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 5 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:order 5 .

