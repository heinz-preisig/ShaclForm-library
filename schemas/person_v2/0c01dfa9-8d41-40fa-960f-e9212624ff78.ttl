# Root Shape
schema:Person a sh:NodeShape ;
    sh:targetClass <https://example.org/person#Person> ;
    rdfs:label "Person" ;
    rdfs:comment "An individual person." ;
    dcterms:source <http://example.org/brick/73d9dc31-2af8-41f0-8587-93c89d79c422/1.0.0/> ;
    sh:property [
        sh:path <https://example.org/person#identifier> ;
        sh:name "Identifier"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 1 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/person#socialSecurityNumber> ;
        sh:name "Social security number"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 2 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/person#birthDate> ;
        sh:name "Birth date"@en ;
        sh:datatype xsd:date ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 3 ;
        dash:editor dash:DatePickerEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/person#nationality> ;
        sh:name "Nationality"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 4 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/person#homeAddress> ;
        sh:node schema:HomeAddress ;
        sh:name "Home address"@en ;
        sh:order 5 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/person#position> ;
        sh:node schema:Position ;
        sh:name "Position"@en ;
        sh:order 6 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] .

