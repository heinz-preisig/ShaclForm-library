@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://example.org/schema/company-three-products/> .
@prefix org: <http://example.org/org/#> .
@prefix ex: <http://example.org/ex/#> .

# Root Shape
schema:CompanyShape a sh:NodeShape ;
    sh:targetClass org:Organization ;
    rdfs:label "CompanyShape" ;
    rdfs:comment "A company with address and products" ;
    sh:property [
        sh:path org:name ;
        sh:name "Company Name"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:homepage ;
        sh:name "Website"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 1 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:hasAddress ;
        sh:node schema:AddressShape ;
        sh:name "AddressShape"@en ;
        sh:order 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] ;
    sh:property [
        sh:path org:managedBy ;
        sh:node schema:PersonShape ;
        sh:name "PersonShape"@en ;
        sh:order 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] ;
    sh:property [
        sh:path org:hasProduct ;
        sh:node schema:Product1Shape ;
        sh:name "Product 1"@en ;
        sh:order 1 ;
        sh:group schema:products ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] ;
    sh:property [
        sh:path org:hasProduct ;
        sh:node schema:Product2Shape ;
        sh:name "Product 2"@en ;
        sh:order 2 ;
        sh:group schema:products ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] ;
    sh:property [
        sh:path org:hasProduct ;
        sh:node schema:Product3Shape ;
        sh:name "Product 3"@en ;
        sh:order 3 ;
        sh:group schema:products ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] .

# Component: 11b65052-988d-49c4-927e-1c770ce2de08 (depth 0)
schema:Person with Address a sh:NodeShape ;
    sh:targetClass schema:Person ;
    rdfs:label "Person with Address" ;
    rdfs:comment "Person that can have US, EU, or freeform address" ;
    sh:property [
        sh:path schema:givenName ;
        sh:name "First Name"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 10 ;
        sh:order 0 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path schema:familyName ;
        sh:name "Last Name"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:order 1 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path schema:email ;
        sh:name "Email"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:order 2 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path schema:address ;
        sh:name "Address"@en ;
        sh:description "Choose address format"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 3 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] .

# Component: b57488a9-8a56-496a-b390-1aa8140814f8 (depth 0)
schema:EU Address a sh:NodeShape ;
    sh:targetClass ex:EUAddress ;
    rdfs:label "EU Address" ;
    rdfs:comment "European address format with country selection" ;
    sh:property [
        sh:path schema:streetAddress ;
        sh:name "Street"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:order 0 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path schema:addressLocality ;
        sh:name "City/Town"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:order 1 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path ex:postalCode ;
        sh:name "Postal Code"@en ;
        sh:description "Format varies by country"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:order 2 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path schema:addressCountry ;
        sh:name "Country"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("ex:DE" "ex:FR" "ex:IT" "ex:ES" "ex:NL" "ex:BE" "ex:AT" "ex:PL") ;
        sh:order 3 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] .

# Component: 3509c09e-1274-40a7-a96a-daf58a361d77 (depth 0)
schema:AddressShape a sh:NodeShape ;
    sh:targetClass org:Address ;
    rdfs:label "AddressShape" ;
    rdfs:comment "Postal address" ;
    sh:property [
        sh:path org:street ;
        sh:name "Street"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:houseNumber ;
        sh:name "Number"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 1 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:zipCode ;
        sh:name "ZIP Code"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:town ;
        sh:name "Town"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 3 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:country ;
        sh:name "Country"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 4 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] .

# Component: product1-shape (depth 0)
schema:Product1Shape a sh:NodeShape ;
    sh:targetClass org:Product ;
    rdfs:label "Product1Shape" ;
    rdfs:comment "First product line" ;
    sh:property [
        sh:path org:productName ;
        sh:name "Product 1 Name"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
        sh:group schema:products ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:description ;
        sh:name "Description"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:order 1 ;
        sh:group schema:products ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:productCode ;
        sh:name "SKU Code"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
        sh:group schema:products ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:managedBy ;
        sh:node schema:PersonShape ;
        sh:name "PersonShape"@en ;
        sh:order 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] ;
    sh:order 1 .

# Component: eb49bf40-422e-4c9e-9b28-0e2bc44f8eb4 (depth 1)
schema:PersonShape a sh:NodeShape ;
    sh:targetClass foaf:Person ;
    rdfs:label "PersonShape" ;
    rdfs:comment "A person (product manager etc.)" ;
    sh:property [
        sh:path foaf:name ;
