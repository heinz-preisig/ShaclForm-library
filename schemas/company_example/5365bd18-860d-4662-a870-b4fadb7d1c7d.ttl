@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://example.org/schema/5365bd18-860d-4662-a870-b4fadb7d1c7d/> .
@prefix org: <http://example.org/org/#> .
@prefix foaf: <http://example.org/foaf/#> .

# Root Shape
schema:CompanyShape a sh:NodeShape ;
    sh:targetClass org:Organization ;
    rdfs:label "CompanyShape" ;
    rdfs:comment "A company with address and products" ;
    sh:property [
        sh:path org:name ;
        sh:name "Company Name"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:homepage ;
        sh:name "Website"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 1 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:hasAddress ;
        sh:node schema:AddressShape ;
        sh:name "AddressShape"@en ;
        sh:order 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] ;
    sh:property [
        sh:path org:hasProduct ;
        sh:node schema:ProductShape ;
        sh:name "ProductShape"@en ;
        sh:order 0 ;
        sh:minCount 0 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] .

# Component: product1-shape (depth 0)
schema:Product1Shape a sh:NodeShape ;
    sh:targetClass org:Product ;
    rdfs:label "Product1Shape" ;
    rdfs:comment "First product line" ;
    sh:property [
        sh:path org:productName ;
        sh:name "Product 1 Name"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
        sh:group schema:mine ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:description ;
        sh:name "Description"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:order 1 ;
        sh:group schema:mine ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:productCode ;
        sh:name "SKU Code"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
        sh:group schema:mine ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:order 0 .

# Component: product2-shape (depth 0)
schema:Product2Shape a sh:NodeShape ;
    sh:targetClass org:Product ;
    rdfs:label "Product2Shape" ;
    rdfs:comment "Second product line" ;
    sh:property [
        sh:path org:productName ;
        sh:name "Product 2 Name"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
        sh:group schema:mine ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:description ;
        sh:name "Description"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:order 1 ;
        sh:group schema:mine ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:productCode ;
        sh:name "SKU Code"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
        sh:group schema:mine ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:order 1 .

# Component: 3509c09e-1274-40a7-a96a-daf58a361d77 (depth 0)
schema:AddressShape a sh:NodeShape ;
    sh:targetClass org:Address ;
    rdfs:label "AddressShape" ;
    rdfs:comment "Postal address" ;
    sh:property [
        sh:path org:street ;
        sh:name "Street"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:houseNumber ;
        sh:name "Number"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 1 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:zipCode ;
        sh:name "ZIP Code"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:town ;
        sh:name "Town"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 3 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:country ;
        sh:name "Country"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 4 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] .

# Component: 02a114b4-cb65-4372-a878-d74f896531d8 (depth 0)
schema:ProductShape a sh:NodeShape ;
    sh:targetClass org:Product ;
    rdfs:label "ProductShape" ;
    rdfs:comment "A product with name and description" ;
    sh:property [
        sh:path org:productName ;
        sh:name "Product Name"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:description ;
        sh:name "Description"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:order 1 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path org:managedBy ;
        sh:node schema:PersonShape ;
        sh:name "PersonShape"@en ;
        sh:order 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] .

# Component: eb49bf40-422e-4c9e-9b28-0e2bc44f8eb4 (depth 1)
schema:PersonShape a sh:NodeShape ;
    sh:targetClass foaf:Person ;
    rdfs:label "PersonShape" ;
    rdfs:comment "A person (product manager etc.)" ;
    sh:property [
        sh:path foaf:name ;
        sh:name "Name"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path foaf:mbox ;
        sh:name "Email"@en ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 1 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] .

# Property Groups
schema:mine a sh:PropertyGroup ;
    rdfs:label "PRODUCTS" ;
    sh:order 0 .

# Group assignments on root shape
schema:CompanyShape sh:property [
    sh:path schema:hasProduct1Shape ;
    sh:node schema:Product1Shape ;
    sh:name "Product1Shape"@en ;
    sh:group schema:mine ;
    sh:order 0 ;
] .

schema:CompanyShape sh:property [
    sh:path schema:hasProduct2Shape ;
    sh:node schema:Product2Shape ;
    sh:name "Product2Shape"@en ;
    sh:group schema:mine ;
    sh:order 1 ;
] .

