# Root Shape
schema:Company a sh:NodeShape ;
    sh:targetClass <https://example.org/companyWithPersonnel#Company> ;
    rdfs:label "Company" ;
    rdfs:comment "A registered company or organisation with personnel." ;
    dcterms:source <http://example.org/brick/4526758e-d7d2-45bf-8094-2f6a6bcefd43/1.0.0/> ;
    sh:property [
        sh:path <https://example.org/companyWithPersonnel#companyName> ;
        sh:name "Company name"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 1 ;
        dash:editor dash:TextFieldEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/companyWithPersonnel#registrationNumber> ;
        sh:name "Registration number"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
