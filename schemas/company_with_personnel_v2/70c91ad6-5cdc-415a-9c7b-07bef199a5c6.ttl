        sh:name "Founded date"@en ;
        sh:datatype xsd:date ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:order 3 ;
        dash:editor dash:DatePickerEditor ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/companyWithPersonnel#registeredAddress> ;
        sh:node schema:RegisteredAddress ;
        sh:name "Registered address"@en ;
        sh:order 4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/companyWithPersonnel#chiefExecutiveOfficer> ;
        sh:node schema:ChiefExecutiveOfficer ;
        sh:name "Chief Executive Officer"@en ;
        sh:order 5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        dash:editor dash:DetailsEditor ;
        dash:viewer dash:DetailsViewer ;
    ] ;
    sh:property [
        sh:path <https://example.org/companyWithPersonnel#chiefTechnologyOfficer> ;
        sh:node schema:ChiefTechnologyOfficer ;
        sh:name "Chief Technology Officer"@en ;
        sh:order 6 ;
        sh:minCount 1 ;
