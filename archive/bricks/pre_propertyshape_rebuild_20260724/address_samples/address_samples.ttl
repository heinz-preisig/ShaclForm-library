@prefix ex: <http://example.org/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:USAddress a sh:NodeShape ;
    rdfs:label "US Address" ;
    rdfs:comment "United States address format with state code and ZIP" ;
    sh:property [
        sh:path schema:streetAddress ;
        rdfs:label "Street Address" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path schema:addressLocality ;
        rdfs:label "City" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path ex:stateCode ;
        rdfs:label "State" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path schema:postalCode ;
        rdfs:label "ZIP Code" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path schema:addressCountry ;
        rdfs:label "Country" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "US" ;
    ] ;
.

ex:EUAddress a sh:NodeShape ;
    rdfs:label "EU Address" ;
    rdfs:comment "European address format with country selection" ;
    sh:property [
        sh:path schema:streetAddress ;
        rdfs:label "Street" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path schema:addressLocality ;
        rdfs:label "City/Town" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path ex:postalCode ;
        rdfs:label "Postal Code" ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path schema:addressCountry ;
        rdfs:label "Country" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
.

ex:FreeformAddress a sh:NodeShape ;
    rdfs:label "Freeform Address" ;
    rdfs:comment "Simple text-based address entry" ;
    sh:property [
        sh:path schema:text ;
        rdfs:label "Full Address" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
.

ex:Person a sh:NodeShape ;
    rdfs:label "Person with Address" ;
    rdfs:comment "Person that can have US, EU, or freeform address" ;
    sh:targetClass schema:Person ;
    sh:property [
        sh:path schema:givenName ;
        rdfs:label "First Name" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path schema:familyName ;
        rdfs:label "Last Name" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path schema:email ;
        rdfs:label "Email" ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path schema:address ;
        rdfs:label "Address" ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:node ex:USAddress ;
        ## Can also be: ex:USAddress ##
        sh:node ex:EUAddress ;
        ## Can also be: ex:EUAddress ##
        sh:node ex:FreeformAddress ;
        ## Can also be: ex:FreeformAddress ##
    ] ;
.
