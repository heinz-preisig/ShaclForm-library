promo:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from" ;
    rdfs:comment "Original ProMo variable IRI used to derive this quantity kind." ;
    rdfs:domain promo:PhysicalVariable .

promo:dimensionalSignature a owl:DatatypeProperty ;
    rdfs:label "dimensional signature" ;
    rdfs:comment "SI dimension exponents in order: mass, length, time, temperature, current, amount, luminosity." ;
    rdfs:domain promo:PhysicalVariable ;
    rdfs:range xsd:string .

promo:hasSymbol a owl:DatatypeProperty ;
    rdfs:label "has symbol" ;
    rdfs:comment "Short symbol for the quantity kind, e.g. T, p, ρ." ;
    rdfs:domain promo:PhysicalVariable ;
    rdfs:range xsd:string .

promo:quantityKind a owl:ObjectProperty ;
    rdfs:label "quantity kind" ;
    rdfs:comment "Link to the corresponding QUDT quantity kind." ;
    rdfs:domain promo:PhysicalVariable ;
    rdfs:range <http://qudt.org/schema/qudt/QuantityKind> .

promo:siUnit a owl:ObjectProperty ;
    rdfs:label "SI unit" ;
    rdfs:comment "Preferred SI unit for this quantity kind." ;
    rdfs:domain promo:PhysicalVariable ;
    rdfs:range <http://qudt.org/schema/qudt/Unit> ;
    rdfs:subPropertyOf promo:has_unit .

promo:has_unit a owl:ObjectProperty ;
    rdfs:label "has unit" ;
    rdfs:comment "Applicable units for this quantity kind." ;
    rdfs:domain promo:PhysicalVariable ;
    rdfs:range <http://qudt.org/schema/qudt/Unit> .

