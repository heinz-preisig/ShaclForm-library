    promo:quantityKind <http://qudt.org/vocab/quantitykind/Time> ;
    promo:siUnit qudt:AttoSEC ;
    rdfs:comment "ProMo quantity kind with dimensional signature M0 L0 T1 Θ0 I0 N0 J0. Derived from 4 ProMo variable(s) with symbols: Time, t_interval, te, to. Documentation: end time; starting time; time; time interval." ;
    rdfs:subClassOf promo:PhysicalVariable ;
    skos:prefLabel "Time" .

promo:Variable a rdfs:Class,
        owl:Class ;
    rdfs:label "Variable" ;
    rdfs:comment "Top class for ProMo variables." .

