    promo:derivedFrom <http://example.org/root#V_1>,
        <http://example.org/root#V_105>,
        <http://example.org/root#V_106>,
        <http://example.org/root#V_107> ;
    promo:dimensionalSignature "0 0 1 0 0 0 0" ;
