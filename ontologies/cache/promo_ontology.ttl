promo:AmountOfSubstance a rdfs:Class,
        owl:Class ;
    rdfs:label "AmountOfSubstance" ;
    promo:derivedFrom <http://example.org/macroscopic#V_139>,
        <http://example.org/macroscopic#V_203>,
        <http://example.org/physical#V_111> ;
    promo:dimensionalSignature "0 0 0 0 0 1 0" ;
    promo:hasSymbol "MolarMass",
        "n",
        "no",
        "nt" ;
    promo:has_unit qudt:CentiMOL,
        qudt:FemtoMOL,
        qudt:IU,
        qudt:KiloMOL,
        qudt:MOL,
        qudt:MOL_LB,
        qudt:MicroMOL,
        qudt:MilliMOL,
        qudt:MilliOSM,
        qudt:NCM,
        qudt:NCM_1ATM_0DEG_C_NL,
        qudt:NanoMOL,
        qudt:OSM,
        qudt:PicoMOL,
        qudt:SCF,
        qudt:SCM,
        qudt:SCM_1ATM_0DEG_C,
        qudt:SCM_1ATM_15DEG_C_ISO,
        qudt:SCM_1ATM_15DEG_C_NL ;
    promo:quantityKind <http://qudt.org/vocab/quantitykind/AmountOfSubstance> ;
    promo:siUnit qudt:CentiMOL ;
    rdfs:comment "ProMo quantity kind with dimensional signature M0 L0 T0 Θ0 I0 N1 J0. Derived from 3 ProMo variable(s) with symbols: MolarMass, no, nt. Documentation: total number of moles; initial mass; fundamental state -- molar mass." ;
    rdfs:subClassOf promo:PhysicalVariable ;
    skos:prefLabel "AmountOfSubstance" .

